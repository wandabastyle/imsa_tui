{
  "name": "imsa-tui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "pnpm run lint && vp check && pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run fmt:check && pnpm run lint && pnpm run check && pnpm run build",
    "fmt:check": "vp fmt --check",
    "fmt": "vp fmt",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --type-aware --type-check src/"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@10.33.0"
}
